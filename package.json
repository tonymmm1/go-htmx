{
    "name": "go-htmx",
    "version": "1.0.0",
    "description": "Go-HTMX starter template",
    "scripts": {
        "dev": "make dev",
        "build": "make build",
        "dev:css": "tailwindcss -i ./src/styles/input.css -o ./static/css/styles.css --watch",
        "build:css": "tailwindcss -i ./src/styles/input.css -o ./static/css/styles.css --minify"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "concurrently": "^10.0.5",
        "daisyui": "^5.7.22",
        "tailwindcss": "^4.3.3"
    }
}

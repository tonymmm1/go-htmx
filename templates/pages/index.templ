package pagetemplates

import "github.com/tonymmm1/go-htmx/templates/layouts"

templ Index() {
	@layouts.Layout(layouts.Meta{
		Description: "A lightweight starter for server-rendered websites with Go, HTMX, Templ, Tailwind CSS, and DaisyUI.",
		Path:        "/",
	}) {
		<div class="hero flex-1 bg-base-200 py-16">
			<div class="hero-content text-center">
				<div class="max-w-md">
					<h1 class="text-5xl font-bold">Hello there!</h1>
					<p class="py-6">Welcome to your Go-HTMX starter template. This is a minimal setup with Templ, Tailwind CSS, and DaisyUI ready to go.</p>
					<a href="/examples" class="btn btn-primary">See HTMX Examples</a>
				</div>
			</div>
		</div>
	}
}

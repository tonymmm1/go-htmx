# Copied to .env by `make setup`. Real environment variables take precedence.

# Port the HTTP server listens on.
PORT=8080

# development: serve static files from disk (no rebuild needed for CSS changes).
# production: serve assets embedded in the binary (the default when unset).
APP_ENV=development

# Reverse-proxy networks whose X-Forwarded-For header is trusted
# (comma-separated CIDRs or IPs). Leave unset when not behind a proxy.
# TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8
